# Switch 2 toolchain, following Dusklight v2.0.3-switch2-1 and ounce-devkit.
# OUNCE_SDK_ROOT may be an unpacked devkit archive: do not replace system libnx.
cmake_minimum_required(VERSION 3.20)
if(NOT DEFINED ENV{DEVKITPRO})
  message(FATAL_ERROR "Set DEVKITPRO to a devkitPro installation")
endif()
file(TO_CMAKE_PATH "$ENV{DEVKITPRO}" DEVKITPRO)
set(OUNCE_SDK_ROOT "${DEVKITPRO}" CACHE PATH "Installed or unpacked ounce-devkit root")
get_filename_component(OUNCE_SDK_ROOT "${OUNCE_SDK_ROOT}" ABSOLUTE)
foreach(required libounce/include/switch.h libounce/switch.specs portlibs/switch2/lib/libvulkan.a)
  if(NOT EXISTS "${OUNCE_SDK_ROOT}/${required}")
    message(FATAL_ERROR "Missing ${OUNCE_SDK_ROOT}/${required}; install or unpack ounce-devkit first")
  endif()
endforeach()
set(CMAKE_SYSTEM_NAME NintendoSwitch)
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
include("${DEVKITPRO}/cmake/devkitA64.cmake")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES OUNCE_SDK_ROOT)
set(NX_ROOT "${OUNCE_SDK_ROOT}/libounce")
set(OUNCE_LIBRARY_DIR "${NX_ROOT}/lib" CACHE PATH "libounce archives built with the selected compiler/newlib")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES OUNCE_LIBRARY_DIR)
set(OUNCE_PORTLIBS "${OUNCE_SDK_ROOT}/portlibs/switch2")
set(DKP_INSTALL_PREFIX_INIT "${OUNCE_PORTLIBS}")
__dkp_platform_prefix("${OUNCE_PORTLIBS}" "${DEVKITPRO}/portlibs/switch" "${NX_ROOT}")
foreach(tool ELF2NRO NACPTOOL)
  string(TOLOWER "${tool}" program)
  find_program(NX_${tool}_EXE NAMES "${program}" HINTS "${DEVKITPRO}/tools/bin" NO_DEFAULT_PATH REQUIRED)
endforeach()
find_file(NX_DEFAULT_ICON default_icon.jpg HINTS "${NX_ROOT}" NO_DEFAULT_PATH)
set(CMAKE_FIND_FRAMEWORK NEVER)
set(CMAKE_FIND_APPBUNDLE NEVER)
set(CMAKE_FIND_USE_PACKAGE_REGISTRY OFF)
set(CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY OFF)
